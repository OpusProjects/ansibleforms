# The AnsibleForms RTE, layer 3 of 3 : the RTE (Dockerfile.rte) + what the AnsibleForms 6.5
# image had - ansible 12 with ansible-core 2.19 (6.5's, NOT the rte image's newer one), the
# python libraries (docker/rte-legacy/requirements.txt), the NetApp, AWS and community
# collections (docker/rte-legacy/collections.yml) and the os tools. For a 6.5 install whose
# playbooks expect them : upgrade, and they keep working.
#
# Starting fresh ? Take ansibleforms-rte and add only what your playbooks use.
#
# BASE_IMAGE : CI passes the RTE it built in the same run, by digest (publish.yml).
ARG BASE_IMAGE=ghcr.io/ansibleforms/ansibleforms-rte:7
FROM ${BASE_IMAGE}

ARG VERSION=
LABEL org.opencontainers.image.title="AnsibleForms RTE (legacy)" \
      org.opencontainers.image.description="The AnsibleForms RTE with the python libraries and collections the 6.5 image had" \
      org.opencontainers.image.version="${VERSION}"

# ytt and the mariadb client were in the 6.5 image too : playbooks may call them
ARG YTT_VERSION=0.55.3
ARG YTT_SHA256_AMD64=15751b45a819edbf22b3d3eadb5fa9a5a2599128d921660a874bd39c47bb41e1
ARG YTT_SHA256_ARM64=fed073d52b780a88ce506e68c44f33cedede2dad3d5f4fbe07a2833e45d996ed
ARG TARGETARCH=amd64
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3-ldap libxslt1.1 curl wget vim sudo tzdata mariadb-client \
 && rm -rf /var/lib/apt/lists/* \
 && case "$TARGETARCH" in \
      amd64) sum="$YTT_SHA256_AMD64" ;; \
      arm64) sum="$YTT_SHA256_ARM64" ;; \
      *) echo "no ytt for $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /usr/local/bin/ytt "https://github.com/carvel-dev/ytt/releases/download/v${YTT_VERSION}/ytt-linux-${TARGETARCH}" \
 && echo "$sum  /usr/local/bin/ytt" | sha256sum -c - \
 && chmod +x /usr/local/bin/ytt

COPY ./docker/rte-legacy/requirements.txt /tmp/legacy-requirements.txt
COPY ./docker/rte-legacy/collections.yml /tmp/legacy-collections.yml
RUN pip install --no-cache-dir -r /tmp/legacy-requirements.txt \
 && ansible-galaxy collection install -r /tmp/legacy-collections.yml -p /usr/share/ansible/collections \
 && rm /tmp/legacy-requirements.txt /tmp/legacy-collections.yml
