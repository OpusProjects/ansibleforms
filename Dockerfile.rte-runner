# The AnsibleForms RTE, layer 2 of 3 - the one to run, and to build on : the base
# (Dockerfile.rte-base) + python, ansible-core and the few libraries most playbooks expect
# (docker/rte-runner/requirements.txt). No collections : add the ones your playbooks use.
#
#   FROM ghcr.io/ansibleforms/ansibleforms-rte-runner:7
#   RUN ansible-galaxy collection install vmware.vmware -p /usr/share/ansible/collections
#   RUN pip install --no-cache-dir pyvmomi
#
# More in examples/rte. A 6.5 install whose playbooks use the collections that image had :
# ansibleforms-rte-legacy (Dockerfile.rte-legacy).
#
# BASE_IMAGE : CI passes the base it built in the same run, by digest (publish.yml).
ARG BASE_IMAGE=ghcr.io/ansibleforms/ansibleforms-rte-base:7
FROM ${BASE_IMAGE}

ARG VERSION=
LABEL org.opencontainers.image.title="AnsibleForms RTE" \
      org.opencontainers.image.description="Runtime environment that runs Ansible playbooks for AnsibleForms : python, ansible-core and the essentials" \
      org.opencontainers.image.version="${VERSION}"

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /venv
ENV PATH="/venv/bin:$PATH"

COPY ./docker/rte-runner/requirements.txt /tmp/rte-requirements.txt
RUN pip install --no-cache-dir -r /tmp/rte-requirements.txt && rm /tmp/rte-requirements.txt
COPY ./server/ansible.cfg /etc/ansible/ansible.cfg
