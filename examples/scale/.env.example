# shared by every AnsibleForms container (app nodes, workers, the RTE)
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
# the same on every container : credentials stored by one must decrypt on all
ENCRYPTION_SECRET=change-me-32-characters-or-more
# the same on every app node : a token signed by one must be accepted by all
ACCESS_TOKEN_SECRET=change-me-a-long-random-string
# the RTE's bearer token (at least 16 characters), also set on the runner in the app
RTE_TOKEN=change-me-at-least-16-chars
# the app nodes serve plain http behind the load balancer
HTTPS=0
