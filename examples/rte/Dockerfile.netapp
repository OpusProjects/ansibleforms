# An RTE for NetApp playbooks : the AnsibleForms RTE + the ONTAP collection and its python
# library. Keep the tag on the app's release (7, or the exact 7.x.y the app runs).
#
#   docker build -f examples/rte/Dockerfile.netapp -t my-rte-netapp .
FROM ghcr.io/ansibleforms/ansibleforms-rte-core:7
RUN ansible-galaxy collection install netapp.ontap -p /usr/share/ansible/collections \
 && pip install --no-cache-dir netapp-lib netapp-ontap
