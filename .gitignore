.DS_Store
node_modules
/dist

# remove local persistent
**/persistent/**

# local env files
.env.development
.env.docker
.env.local
.env.*.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# remote sycn files
.remote-sync.json

# forms.yaml
forms.yaml
*.personal

# ontap stuff
ontap*.yaml

# build artifacts (generated during build)
build-info.json

# test coverage reports (vitest writes client/coverage and server/coverage)
coverage

# local post-build scripts (may contain credentials)
*.post.sh

# Docker Hub PATs for publish*.sh - the real one belongs in ~/.docker-hub-pat
# (outside the repo entirely), never here; this just guards against a stray local copy.
.docker-hub-pat

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# workspace
*.code-workspace

# temporary files
.tmp-*
*.tmp

# python venv
.venv

# dist folder
dist

# tar file
ansibleforms.tar

# copied from server/help.yaml when the docs site is built
docs/_data/help.yaml
