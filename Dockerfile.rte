# The AnsibleForms RTE (runtime environment) : the server started with AF_ROLE=rte, which
# runs playbooks for an AnsibleForms app. Same base image as the app, so a playbook finds
# the same ansible, python packages and collections in both.
#
# Make it your own : fork this file, add what your playbooks need after the final FROM,
#   RUN ansible-galaxy collection install vmware.vmware -p /usr/share/ansible/collections
#   RUN /venv/bin/pip install pyvmomi
# and build it : docker build -f Dockerfile.rte -t my-rte .
#
# The base is pinned by digest, the same pin as Dockerfile (keep the two equal).
FROM ansibleguy/ansibleforms-base:latest@sha256:8a1ea5dd0a80be59ce78b4520893e0d42dc0d1231c0af02064a48bce5aad4b23 AS builder

ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG VERSION=

WORKDIR /app/server
COPY ./server/package*.json ./
RUN npm ci --omit=dev
COPY ./server .
COPY ./generate-build-info.sh /tmp/generate-build-info.sh
RUN chmod +x /tmp/generate-build-info.sh && /tmp/generate-build-info.sh . "$GIT_SHA" "$BUILD_TIME" "$VERSION"
# no web interface in an RTE
RUN rm -f .env.* && rm -rf ./views

FROM ansibleguy/ansibleforms-base:latest@sha256:8a1ea5dd0a80be59ce78b4520893e0d42dc0d1231c0af02064a48bce5aad4b23 AS final

ARG VERSION=
LABEL org.opencontainers.image.source="https://github.com/ansibleforms/ansibleforms" \
      org.opencontainers.image.url="https://ansibleforms.com" \
      org.opencontainers.image.title="AnsibleForms RTE" \
      org.opencontainers.image.description="Runtime environment that runs Ansible playbooks for AnsibleForms" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${VERSION}"

WORKDIR /app/dist
COPY --from=builder /app/server/. ./
COPY ./server/ansible.cfg /etc/ansible/ansible.cfg

ENV AF_ROLE=rte
ENTRYPOINT ["node", "./index.js"]
